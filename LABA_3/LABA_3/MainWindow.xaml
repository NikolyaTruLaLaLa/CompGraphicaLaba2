<Window x:Class="LABA_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Компьютерная графика — Лаба 1" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль для кнопок тулбара -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="ToggleTool" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ================= ВЕРХНИЙ TOOLBAR ================= -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button x:Name="BtnLoadImage" Content="Загрузить"
                        Style="{StaticResource ToolButton}"
                        Click="BtnLoadImage_Click"
                        ToolTip="Загрузить изображение из файла"/>

                <Button x:Name="BtnClearCanvas" Content="Очистить"
                        Style="{StaticResource ToolButton}"
                        Click="BtnClearCanvas_Click"
                        ToolTip="Очистить холст (белый лист)"/>

                <Separator/>

                <ToggleButton x:Name="TglDrawRegion" Content="Рисовать область"
                              Style="{StaticResource ToggleTool}"
                              Checked="TglDrawRegion_Checked"
                              Unchecked="TglDrawRegion_Unchecked"
                              ToolTip="Рисовать контур области мышкой"/>

                <ToggleButton x:Name="TglFillImage" Content="Заливка картинкой"
                              Style="{StaticResource ToggleTool}"
                              Checked="TglFillImage_Checked"
                              Unchecked="TglFillImage_Unchecked"
                              ToolTip="Кликнуть внутри области для заливки"/>

                <ToggleButton x:Name="TglFillColor" Content="Заливка цветом"
                              Style="{StaticResource ToggleTool}"
                              Checked="TglFillColor_Checked"
                              Unchecked="TglFillColor_Unchecked"
                              ToolTip="Кликнуть внутри области для заливки"/>

                <ToggleButton x:Name="TglPickBoundary" Content="Обход границы"
                              Style="{StaticResource ToggleTool}"
                              Checked="TglPickBoundary_Checked"
                              Unchecked="TglPickBoundary_Unchecked"
                              ToolTip="Кликнуть по границе для её обхода"/>

                <Separator/>

                <Button x:Name="BtnSaveImage" Content="Сохранить"
                        Style="{StaticResource ToolButton}"
                        Click="BtnSaveImage_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ================= ПАНЕЛЬ ОПЦИЙ ================= -->
        <Border DockPanel.Dock="Top" 
                Background="#F3F3F3" 
                BorderBrush="#DDDDDD" 
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Цвет заливки -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Цвет:" VerticalAlignment="Center" 
                               FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Border BorderBrush="Gray" BorderThickness="1" 
                            Width="32" Height="24">
                        <Rectangle x:Name="RectFillColor" Fill="Red"
                                   MouseLeftButtonDown="RectFillColor_MouseLeftButtonDown"/>
                    </Border>
                </StackPanel>

                <!-- Паттерн -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <TextBlock Text="Паттерн:" VerticalAlignment="Center" 
                               FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Button x:Name="BtnLoadPattern" Content="Загрузить..."
                            Padding="8,3" Click="BtnLoadPattern_Click"/>
                    <CheckBox x:Name="ChkCyclePattern" Content="Циклически"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="True"
                              ToolTip="Повторять рисунок по области (для маленьких файлов)"/>
                </StackPanel>

                <!-- Статус -->
                <TextBlock Grid.Column="3" x:Name="TxtStatus" 
                           Text="Готово" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center"
                           Foreground="#666666"/>
            </Grid>
        </Border>

        <!-- ================= СТАТУС-БАР СНИЗУ ================= -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="TxtCoords" Text="x: -, y: -"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtCanvasSize" Text="Холст: —"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ================= ХОЛСТ ================= -->
        <ScrollViewer x:Name="ScrollCanvas"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#808080">
            <Border BorderBrush="Black" BorderThickness="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="20">
                <Image x:Name="ImgCanvas"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseDown="ImgCanvas_MouseDown"
                       MouseMove="ImgCanvas_MouseMove"
                       MouseUp="ImgCanvas_MouseUp"/>
            </Border>
        </ScrollViewer>

    </DockPanel>
</Window>