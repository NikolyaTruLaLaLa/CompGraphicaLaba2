<Window x:Class="LABA_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LABA_3.Controls"
        Title="Лаба 3: Растровая графика" Height="700" Width="900">

    <!-- Окно с тремя вкладками-заданиями.
         Каждое задание — отдельный UserControl из папки Controls,
         вся работа с пикселями вынесена в классы из папки Drawing. -->
    <TabControl Margin="10">

        <TabItem Header="Задание 1">
            <!-- Задание 1 (заливка и граница) — пока в разработке -->
				<local:FillAndBoundaryControl/>
        </TabItem>

        <TabItem Header="Задание 2">
            <!-- Задание 2: отрезки Брезенхема и Ву (Controls/LineDrawingControl) -->
            <local:LineDrawingControl/>
        </TabItem>

        <TabItem Header="Задание 3">
            <!-- Задание 3: градиентный треугольник (Controls/GradientTriangleControl) -->
            <local:GradientTriangleControl/>
        </TabItem>

    </TabControl>
</Window>