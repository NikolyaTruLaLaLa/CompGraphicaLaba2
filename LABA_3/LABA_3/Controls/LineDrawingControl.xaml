<UserControl x:Class="LABA_3.Controls.LineDrawingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Алгоритм:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="AlgorithmCombo" Width="150" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0" SelectedIndex="0">
                <ComboBoxItem Content="Брезенхем"/>
                <ComboBoxItem Content="Ву"/>
            </ComboBox>

            <Button Content="Очистить" Click="Clear_Click" Width="120" Height="35" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>

            <TextBlock x:Name="StatusText" Text="Кликните на холсте для начала отрезка" FontSize="14" Foreground="DarkBlue" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Background="White" Focusable="False" Width="602" Height="452" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="DrawingCanvas" Width="600" Height="450" Background="White" MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" FocusVisualStyle="{x:Null}">
                <Image x:Name="CanvasImage" Width="600" Height="450"/>
            </Canvas>
        </Border>
    </Grid>
</UserControl>