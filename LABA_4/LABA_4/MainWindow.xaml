<Window x:Class="LABA_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LABA_4.UI.SceneControls"
        Title="LABA 4 — Scene" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="btnDrawMode"
                              Content="Режим рисования"
                              Width="140" Height="30"
                              Margin="0,0,8,0"
                              Checked="DrawMode_Changed"
                              Unchecked="DrawMode_Changed"/>

                <Button x:Name="btnClear"
                        Content="Очистить сцену"
                        Width="130" Height="30"
                        Margin="0,0,16,0"
                        Click="btnClear_Click"/>

                <GroupBox Header="Преобразование" Padding="6" Margin="0,0,16,0">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbTransform" Width="175" SelectedIndex="2"
                                  VerticalAlignment="Center"
                                  SelectionChanged="Transform_SelectionChanged">
                            <ComboBoxItem Content="Смещение (dx, dy)"/>
                            <ComboBoxItem Content="Поворот вокруг точки"/>
                            <ComboBoxItem Content="Поворот вокруг центра"/>
                            <ComboBoxItem Content="Масштаб вокруг точки"/>
                            <ComboBoxItem Content="Масштаб вокруг центра"/>
                        </ComboBox>
                        <StackPanel x:Name="pDx" Orientation="Horizontal">
                            <TextBlock Text="dx:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbDx" Width="55" Text="20"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="pDy" Orientation="Horizontal">
                            <TextBlock Text="dy:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbDy" Width="55" Text="20"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="pAngle" Orientation="Horizontal">
                            <TextBlock Text="Угол (°):" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbAngle" Width="55" Text="45"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="pSx" Orientation="Horizontal">
                            <TextBlock Text="sx:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbSx" Width="55" Text="1.2"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="pSy" Orientation="Horizontal">
                            <TextBlock Text="sy:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbSy" Width="55" Text="1.2"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="pPx" Orientation="Horizontal">
                            <TextBlock Text="px:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbPx" Width="55" Text="0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="pPy" Orientation="Horizontal">
                            <TextBlock Text="py:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="tbPy" Width="55" Text="0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Применить" Margin="8,0,0,0" Height="26"
                                Click="ApplyTransform_Click"/>
                    </WrapPanel>
                </GroupBox>

                <Separator Margin="0,0,16,0" Width="1" Background="#CCC"/>

                <GroupBox Header="Точка в полигоне" Padding="6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="btnPointInPolyMode"
                                      Content="Точка в полигоне"
                                      Width="140" Height="30"
                                      Margin="0,0,8,0"
                                      Checked="PointInPolyMode_Changed"
                                      Unchecked="PointInPolyMode_Changed"/>
                        <TextBlock x:Name="tbPointInPolyResult" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Пересечение отрезков" Padding="6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="btnFindIntersections"
                                Content="Показать пересечения"
                                Width="180" Height="30"
                                Margin="0,0,8,0"
                                Checked="FindIntersections_Click"
                                Unchecked="FindIntersections_Unchecked"/>
                        <TextBlock x:Name="tbIntersectionCount" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Точка относительно ребра" Padding="6">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="btnPointEdgeMode"
                                      Content="Точка отн. ребра"
                                      Width="140" Height="30"
                                      Margin="0,0,8,0"
                                      Checked="PointEdgeMode_Changed"
                                      Unchecked="PointEdgeMode_Changed"/>
                        <TextBlock x:Name="tbPointEdgeResult" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </Border>

        <!-- Scene Canvas -->
        <controls:SceneCanvas x:Name="SceneView" Grid.Row="1"/>

        <!-- Bottom Status/Help Bar -->
        <Border Grid.Row="2" Background="#E8E8E8" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="tbStatusText" 
                       FontSize="13" 
                       Foreground="#444"
                       TextWrapping="Wrap"
                       Text="Shift+ЛКМ — выбрать объект, ЛКМ — проверить точку"/>
        </Border>
    </Grid>
</Window>