<Window x:Class="LABA_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LABA_4.UI.SceneControls"
        Title="LABA 4 — Scene" Height="800" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" Padding="8">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="btnDrawMode"
                              Content="Режим рисования"
                              Width="140" Height="30"
                              Margin="0,0,8,0"
                              Checked="DrawMode_Changed"
                              Unchecked="DrawMode_Changed"/>

                <Button x:Name="btnClear"
                        Content="Очистить сцену"
                        Width="130" Height="30"
                        Margin="0,0,16,0"
                        Click="btnClear_Click"/>

                <GroupBox Header="Преобразование" Padding="6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cmbTransform" Width="110" SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Поворот"/>
                        </ComboBox>
                        <TextBlock Text="Угол (°):" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="tbAngle" Width="55" Text="45"
                                 VerticalAlignment="Center"/>
                        <Button Content="Применить" Margin="8,0,0,0" Height="26"
                                Click="ApplyTransform_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Проверка" Padding="6">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cmbCheck" Width="140" SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Точка в полигоне"/>
                        </ComboBox>
                        <TextBlock Text="X:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="tbCheckX" Width="50" Text="0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="tbCheckY" Width="50" Text="0"
                                 VerticalAlignment="Center"/>
                        <Button Content="Проверить" Margin="8,0,0,0" Height="26"
                                Click="Check_Click"/>
                        <TextBlock x:Name="tbCheckResult" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </Border>

        <controls:SceneCanvas x:Name="SceneView" Grid.Row="1"/>
    </Grid>
</Window>