<Window x:Class="BezierSpline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа" Height="700" Width="1220"
        Background="#EEE">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D2D30" Padding="0">
            <StackPanel>
                <TextBlock Text="Задания" Foreground="White" FontSize="16"
                           Margin="16,20,16,12" FontWeight="SemiBold"/>
                <ListBox x:Name="taskList"
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         SelectionChanged="TaskList_SelectionChanged">
                    <ListBoxItem Content="Задание 1" Padding="16,10"/>
                    <ListBoxItem Content="Задание 2 — Midpoint Displacement" Padding="16,10"/>
                    <ListBoxItem Content="Задание 3 — Сплайны Безье" Padding="16,10"/>
                </ListBox>
            </StackPanel>
        </Border>

        <ContentControl x:Name="taskHost" Grid.Column="1"/>
    </Grid>
</Window>