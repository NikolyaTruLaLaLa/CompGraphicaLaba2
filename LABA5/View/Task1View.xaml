<UserControl x:Class="BezierSpline.Views.Task1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BezierSpline.Views">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Пресет и параметры -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Фрактал:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="presetCombo" Width="170" VerticalAlignment="Center"
                          SelectionChanged="Preset_SelectionChanged">
                    <ComboBoxItem Content="Коха (снежинка)"/>
                    <ComboBoxItem Content="Серпинского (треугольник)"/>
                    <ComboBoxItem Content="Дракон"/>
                    <ComboBoxItem Content="Растение"/>
                    <ComboBoxItem Content="Дерево"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Итерации:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="iterationsSlider" Minimum="1" Maximum="16" Value="4" Width="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="iterationsValue" Text="4" Width="24" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Случайность:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="randomnessSlider" Minimum="0" Maximum="1" Value="0" Width="80"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="randomnessValue" Text="0%" Width="36" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Джиттер угла:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="jitterSlider" Minimum="0" Maximum="15" Value="0" Width="80"
                        TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="jitterValue" Text="0°" Width="36" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Файл, режим дерева, построение -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,10,10" VerticalAlignment="Center">
            <TextBlock Text="Файл:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="fileBox" Width="280" VerticalAlignment="Center" IsReadOnly="True"/>
            <Button Content="Из файла" Padding="12,4" Margin="10,0,0,0" Click="LoadFile_Click"/>
            <CheckBox x:Name="treeModeCheck" Content="Толщина и цвет по глубине (дерево)"
                      VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Content="Построить" Padding="12,4" Margin="20,0,0,0" Click="Build_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="10" Background="White" BorderBrush="#CCC" BorderThickness="1">
            <local:LSystemCanvas x:Name="canvas"/>
        </Border>
    </Grid>
</UserControl>
