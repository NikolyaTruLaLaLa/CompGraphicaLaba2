<UserControl x:Class="BezierSpline.Views.Task2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Первый ряд: слайдеры -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Итерации:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="iterationsSlider" Minimum="1" Maximum="10" Value="6" Width="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="iterationsValue" Text="6" Width="20" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Шероховатость (H):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="roughnessSlider" Minimum="0.1" Maximum="1.0" Value="0.5" Width="100"
                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        SmallChange="0.1" LargeChange="0.1"/>
                <TextBlock x:Name="roughnessValue" Text="0.5" Width="30" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Начальное смещение:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="displacementSlider" Minimum="0.05" Maximum="0.5" Value="0.3" Width="100"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        SmallChange="0.05" LargeChange="0.05"/>
                <TextBlock x:Name="displacementValue" Text="0.30" Width="40" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Второй ряд: Seed и кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,10,10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="seedBox" Width="60" VerticalAlignment="Center" Text="12345"/>
            </StackPanel>

            <Button Content="Сгенерировать" Padding="12,4" Margin="0,0,10,0" Click="Generate_Click"/>
            <Button x:Name="showStepsBtn" Content="Показать шаги" Padding="12,4" Click="ShowSteps_Click"/>
            <Button x:Name="nextStepBtn" Content="Следующий шаг" Padding="12,4" Margin="10,0,0,0" Click="NextStep_Click" Visibility="Collapsed"/>
        </StackPanel>

        <Canvas x:Name="canvas" Grid.Row="2" Margin="10"
                Background="White" ClipToBounds="True"/>
    </Grid>
</UserControl>