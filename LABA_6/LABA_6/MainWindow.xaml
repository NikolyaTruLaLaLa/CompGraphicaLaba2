<Window x:Class="LABA_6.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лаба 6 - Аффинные преобразования" Height="700" Width="1000"
        Loaded="OnWindowLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Canvas x:Name="DrawCanvas" Grid.Column="0" Background="Black" 
                SizeChanged="OnCanvasSizeChanged"/>

        <ScrollViewer Grid.Column="1" Background="#1E1E1E" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <GroupBox Header="Многогранник" Foreground="White">
                    <StackPanel Margin="2">
                        <ComboBox x:Name="PolyhedronComboBox" SelectionChanged="OnPolyhedronChanged" Margin="0,5">
                            <ComboBoxItem Content="Тетраэдр" IsSelected="True"/>
                            <ComboBoxItem Content="Гексаэдр (Куб)"/>
                            <ComboBoxItem Content="Октаэдр"/>
                            <ComboBoxItem Content="Икосаэдр"/>
                            <ComboBoxItem Content="Додекаэдр"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
                <Button Content="Сбросить все преобразования" Click="OnResetClick" Margin="0,5" Padding="3"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Загрузить (.obj)" Click="OnLoadObjClick" Padding="3" Margin="0,0,2,0" Grid.Column="0"/>
                    <Button Content="Сохранить (.obj)" Click="OnSaveObjClick" Padding="3" Margin="2,0,0,0" Grid.Column="1"/>
                </Grid>


                <GroupBox Header="Проекция" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <RadioButton x:Name="PerspectiveRadio" Content="Перспективная" Foreground="White" 
                                     IsChecked="True" Checked="OnProjectionChanged" GroupName="Proj"/>
                        <RadioButton x:Name="AxonometricRadio" Content="Аксонометрическая" Foreground="White" 
                                     Checked="OnProjectionChanged" GroupName="Proj"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Смещение (Translation)" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <UniformGrid Columns="3">
                            <TextBlock Text="dx" Foreground="Gray"/>
                            <TextBlock Text="dy" Foreground="Gray"/>
                            <TextBlock Text="dz" Foreground="Gray"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="TxBox" Text="0"/>
                            <TextBox x:Name="TyBox" Text="0"/>
                            <TextBox x:Name="TzBox" Text="0"/>
                        </UniformGrid>
                        <Button Content="Сместить" Click="OnTranslateClick" Margin="0,5" Padding="2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Поворот вокруг X/Y/Z (градусы)" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <UniformGrid Columns="3">
                            <TextBlock Text="Угол X" Foreground="Gray"/>
                            <TextBlock Text="Угол Y" Foreground="Gray"/>
                            <TextBlock Text="Угол Z" Foreground="Gray"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="RxBox" Text="0"/>
                            <TextBox x:Name="RyBox" Text="0"/>
                            <TextBox x:Name="RzBox" Text="0"/>
                        </UniformGrid>
                        <Button Content="Повернуть" Click="OnRotateClick" Margin="0,5" Padding="2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Масштаб (Scale)" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <UniformGrid Columns="3">
                            <TextBlock Text="sx" Foreground="Gray"/>
                            <TextBlock Text="sy" Foreground="Gray"/>
                            <TextBlock Text="sz" Foreground="Gray"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="SxBox" Text="1"/>
                            <TextBox x:Name="SyBox" Text="1"/>
                            <TextBox x:Name="SzBox" Text="1"/>
                        </UniformGrid>
                        <Button Content="Масштабировать" Click="OnScaleClick" Margin="0,5" Padding="2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Отражение относительно плоскости" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <ComboBox x:Name="ReflectionComboBox" Margin="0,5">
                            <ComboBoxItem Content="Плоскость XY" IsSelected="True"/>
                            <ComboBoxItem Content="Плоскость XZ"/>
                            <ComboBoxItem Content="Плоскость YZ"/>
                        </ComboBox>
                        <Button Content="Отразить" Click="OnReflectClick" Margin="0,5" Padding="2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Спец. преобразования" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <TextBlock Text="Масштаб относительно центра:" Foreground="White" Margin="0,5,0,0"/>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="CxBox" Text="1"/>
                            <TextBox x:Name="CyBox" Text="1"/>
                            <TextBox x:Name="CzBox" Text="1"/>
                        </UniformGrid>
                        <Button Content="Масштаб от центра" Click="OnCenterScaleClick" Margin="0,5" Padding="2"/>

                        <TextBlock Text="Вращение через центр ∥ оси:" Foreground="White" Margin="0,10,0,0"/>
                        <UniformGrid Columns="2">
                            <ComboBox x:Name="CenterAxisCombo" Margin="0,0,5,0">
                                <ComboBoxItem Content="Ось X" IsSelected="True"/>
                                <ComboBoxItem Content="Ось Y"/>
                                <ComboBoxItem Content="Ось Z"/>
                            </ComboBox>
                            <TextBox x:Name="CenterAngleBox" Text="45"/>
                        </UniformGrid>
                        <Button Content="Вращать от центра" Click="OnCenterRotateClick" Margin="0,5" Padding="2"/>

                        <TextBlock Text="Прямая (P1 → P2) и Угол:" Foreground="White" Margin="0,10,0,0"/>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="P1x" Text="0"/>
                            <TextBox x:Name="P1y" Text="0"/>
                            <TextBox x:Name="P1z" Text="0"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="P2x" Text="0"/>
                            <TextBox x:Name="P2y" Text="1"/>
                            <TextBox x:Name="P2z" Text="0"/>
                        </UniformGrid>
                        <TextBox x:Name="LineAngleBox" Text="45" Margin="0,2"/>
                        <Button Content="Вращать вокруг прямой" Click="OnLineRotateClick" Margin="0,5" Padding="2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Тело вращения" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <ComboBox x:Name="ProfileComboBox" SelectionChanged="OnProfileChanged" Margin="0,0,0,5">
                            <ComboBoxItem Content="Цилиндр" IsSelected="True"/>
                            <ComboBoxItem Content="Конус"/>
                            <ComboBoxItem Content="Ваза"/>
                            <ComboBoxItem Content="Сфера"/>
                            <ComboBoxItem Content="Свой профиль"/>
                        </ComboBox>

                        <TextBlock Text="Профиль (X,Y; X,Y...):" Foreground="Gray"/>
                        <TextBox x:Name="ProfileTextBox" Text="1,0; 1,3" Margin="0,0,0,5" IsEnabled="False"/>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Ось:" Foreground="Gray"/>
                                <ComboBox x:Name="RevAxisComboBox">
                                    <ComboBoxItem Content="X"/>
                                    <ComboBoxItem Content="Y" IsSelected="True"/>
                                    <ComboBoxItem Content="Z"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Разбиений:" Foreground="Gray"/>
                                <TextBox x:Name="DivisionsTextBox" Text="24"/>
                            </StackPanel>
                        </UniformGrid>

                        <Button Content="Построить вращением" Click="OnBuildRevolutionClick" Margin="0,8,0,0" Padding="3"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="График функции f(x, y)" Foreground="White" Margin="0,10,0,0">
                    <StackPanel Margin="2">
                        <ComboBox x:Name="FunctionComboBox" SelectionChanged="OnFunctionSelectionChanged" Margin="0,0,0,5">
                            <ComboBoxItem Content="Плоскость (z = x + y)" IsSelected="True"/>
                            <ComboBoxItem Content="Параболоид (z = x² + y²)"/>
                            <ComboBoxItem Content="Седло (z = x² - y²)"/>
                            <ComboBoxItem Content="Волна (z = sin(x)*cos(y))"/>
                            <ComboBoxItem Content="Своя функция (введите ниже)"/>
                        </ComboBox>

                        <TextBlock Text="Диапазоны X и Y:" Foreground="Gray"/>
                        <UniformGrid Columns="4" Margin="0,0,0,5">
                            <TextBox x:Name="XMinBox" Text="-2"/>
                            <TextBox x:Name="XMaxBox" Text="2"/>
                            <TextBox x:Name="YMinBox" Text="-2"/>
                            <TextBox x:Name="YMaxBox" Text="2"/>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Разбиений:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="GraphDivisionsBox" Text="20" Width="50"/>
                        </StackPanel>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="f(x,y) =" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="CustomFormulaBox" Grid.Column="1" Text="sin(x) + cos(y)" IsEnabled="False" ToolTip="Пример: x^2 + y^2, sin(x)*cos(y), sqrt(x^2+y^2)"/>
                        </Grid>

                        <Button Content="Построить график" Click="OnBuildGraphClick" Margin="0,8,0,0" Padding="3"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>